---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { CATEGORIES, href } from '../../lib/site.mjs';
export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category: category.id }, props: { category } }));
}
const { category } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.category === category.id);
---
<Base title={category.name} active="archive" description={category.description}>
  <div class="shell inner-page">
    <header class="page-heading">
      <p class="eyebrow">CHAPTER {category.number} / {category.english.toUpperCase()}</p>
      <h1>{category.name}<span class="heading-aside">{category.english}</span></h1>
      <p>{category.description}</p>
    </header>
    <nav class="category-tabs standalone-tabs" aria-label="文章分类">
      <a href={href('archive/')}>全部</a>
      {CATEGORIES.map((item) => <a class:list={{ active: item.id === category.id }} href={href('category/' + item.id + '/')} aria-current={item.id === category.id ? 'page' : undefined}>{item.name}</a>)}
    </nav>
    {posts.length ? <section aria-label={category.name + '文章'}><h2 class="sr-only">分类文章</h2><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></section> : (
      <div class="empty-category">
        <span class="empty-flourish" aria-hidden="true">～</span>
        <h2>这一页，先留一点空白。</h2>
        <p>还没有公开的{category.name}。</p>
        <a class="text-link" href={href('archive/')}>去读其他文章 <span aria-hidden="true">→</span></a>
      </div>
    )}
  </div>
</Base>
