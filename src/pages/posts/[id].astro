---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, postMeta } from '../../lib/posts';
import { href } from '../../lib/site.mjs';
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const meta = postMeta(post);
const toc = headings.filter((heading) => heading.depth === 2);
const related = (await getPosts()).filter((item) => item.id !== post.id).slice(0, 2);
---
<Base title={post.data.title} description={post.data.description} active="archive" article={{ title: post.data.title, date: post.data.date }}>
  <progress class="reading-progress" max="100" value="0" aria-label="文章阅读进度" />
  <div class="shell article-page">
    <nav class="breadcrumb" aria-label="当前位置"><a href={href('archive/')}>全部文章</a><span aria-hidden="true">/</span><a href={href('category/' + post.data.category + '/')}>{meta.category.name}</a></nav>
    <header class="article-header">
      <p class="eyebrow">{meta.category.english.toUpperCase()} / {meta.category.name}</p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-byline"><span class="byline-avatar" aria-hidden="true">h.</span><span>Hokkaido</span><span class="meta-dot" aria-hidden="true">·</span><time datetime={post.data.date.toISOString().slice(0, 10)}>{meta.date}</time><span class="meta-dot" aria-hidden="true">·</span><span>{meta.minutes} 分钟阅读</span></div>
    </header>
    <div class="article-layout">
      <div>
        <article class="prose article-body" id="article-body"><Content /></article>
        <div class="article-end">
          <div class="article-tags" aria-label="文章标签">{post.data.tags.map((tag) => <span>#{tag}</span>)}</div>
          <div class="share-row"><button class="text-link" type="button" id="copy-link"><Icon name="copy" size={16} /> 复制文章链接</button><span id="copy-status" role="status" aria-live="polite"></span></div>
        </div>
      </div>
      <aside class="article-sidebar" aria-label="文章目录">
        <details class="toc-sticky">
          <summary>文章目录</summary>
          <ol>{toc.map((heading) => <li><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ol>
          <a class="text-link back-top" href="#top">回到顶部 <Icon name="up" size={15} /></a>
        </details>
      </aside>
    </div>
    {related.length > 0 && <section class="related-section" aria-labelledby="related-title"><div class="section-heading"><div><p class="eyebrow">KEEP READING</p><h2 id="related-title">接着读</h2></div><a class="text-link" href={href('archive/')}>全部文章 <Icon name="arrow" size={17} /></a></div><div class="related-grid">{related.map((item) => <PostCard post={item} compact />)}</div></section>}
  </div>
  <script>import '../../scripts/article';</script>
</Base>
