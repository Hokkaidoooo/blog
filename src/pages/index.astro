---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { CATEGORIES, href } from '../lib/site.mjs';
const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const recent = posts.filter((post) => post.id !== featured?.id).slice(0, 2);
---
<Base active="home">
  <div class="shell">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="small-line" /> A PERSONAL JOURNAL</p>
        <h1 id="hero-title">在这里，<br />写下<span class="serif-italic">所思所见。</span></h1>
        <p class="hero-description">我是 Hokkaido。这里存放学习笔记，<br class="desktop-break" />也留一点空间，记录日常与创作。</p>
        <div class="hero-actions">
          <a class="button-primary" href="#latest">开始阅读 <Icon name="arrow" size={18} /></a>
          <a class="text-link" href={href('about/')}>关于这个博客 <Icon name="external" size={15} /></a>
        </div>
        <div class="hero-signature"><span class="signature">Hokkaido</span><span>学习，也生活。</span></div>
      </div>
      <figure class="hero-figure">
        <div class="hero-photo">
          <img src={href('images/landscape.jpg')} alt="群山与湖泊之间的一座小屋，倒影映在安静的水面上" width="1400" height="933" fetchpriority="high" />
        </div>
        <figcaption><span>THE JOURNAL</span><span>留一页，给日常。 <Icon name="leaf" size={16} /></span></figcaption>
      </figure>
    </section>

    <section class="latest-section" id="latest" aria-labelledby="latest-title">
      <div class="section-heading">
        <div><p class="eyebrow">RECENT ENTRIES</p><h2 id="latest-title">最近写下的</h2></div>
        <a class="text-link" href={href('archive/')}>全部文章 <Icon name="arrow" size={17} /></a>
      </div>
      {featured ? (
        <div class="latest-layout">
          <PostCard post={featured} />
          <div class="recent-list">{recent.map((post) => <PostCard post={post} compact />)}</div>
        </div>
      ) : <p class="empty-message">还没有公开文章。</p>}
    </section>

    <nav class="topic-grid" aria-label="文章分类">
      {CATEGORIES.map((category) => (
        <a class="topic-tile" href={href('category/' + category.id + '/')}>
          <span class="topic-number">{category.number}</span>
          <div><h2>{category.name}<span>{category.english}</span></h2><p>{category.description}</p></div>
          <Icon name="external" size={18} />
        </a>
      ))}
    </nav>

    <section class="about-strip" aria-labelledby="hello-title">
      <div class="about-seal" aria-hidden="true"><Icon name="leaf" size={29} /></div>
      <div><p class="eyebrow">A LITTLE ABOUT ME</p><h2 id="hello-title">你好，我是 Hokkaido。</h2><p>在代码和文字之间，慢慢积累自己的理解。</p></div>
      <a class="text-link" href={href('about/')}>认识一下 <Icon name="external" size={17} /></a>
    </section>
  </div>
</Base>
