---
import Icon from './Icon.astro';
import { href } from '../lib/site.mjs';
---
<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title" data-index={href('search.json')}>
  <div class="search-topline">
    <h2 id="search-title">找一篇手记</h2>
    <button class="icon-button" type="button" data-search-close aria-label="关闭搜索"><Icon name="close" /></button>
  </div>
  <label class="search-input-wrap">
    <Icon name="search" />
    <span class="sr-only">搜索标题、标签或正文</span>
    <input id="site-search" type="search" placeholder="搜索标题、标签或正文…" autocomplete="off" />
  </label>
  <p class="search-status" role="status" aria-live="polite">输入关键词，找回一个想法。</p>
  <ul class="search-results" aria-label="搜索结果"></ul>
  <button class="text-link search-retry" type="button" hidden>重新加载文章</button>
  <div class="search-bottom"><span>也可以试试：HTTP、Cache、写作</span><span><kbd>Esc</kbd> 关闭</span></div>
</dialog>
<script>
  import '../scripts/search';
</script>
