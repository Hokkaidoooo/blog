---
import Icon from './Icon.astro';
import { postMeta, postUrl, type Post } from '../lib/posts';
import { coverInfo } from '../lib/site.mjs';
interface Props {
  post: Post;
  compact?: boolean;
}
const { post, compact = false } = Astro.props;
const meta = postMeta(post);
const cover = coverInfo(post.data.cover);
---
<article class:list={['post-card', { 'post-card-compact': compact }]}>
  <a class="post-image" href={postUrl(post)} tabindex="-1" aria-hidden="true">
    <img src={cover.src} alt="" width="1200" height="760" loading="lazy" />
  </a>
  <div class="post-copy">
    <div class="post-meta">
      <span>{meta.category.name}</span><span class="meta-dot" aria-hidden="true">·</span>
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{meta.date}</time>
    </div>
    <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
    <p class="post-description">{post.data.description}</p>
    <div class="post-bottom">
      <span>{meta.minutes} 分钟阅读</span>
      <a class="read-link" href={postUrl(post)} aria-label={'阅读：' + post.data.title}>阅读全文 <Icon name="arrow" size={16} /></a>
    </div>
  </div>
</article>
